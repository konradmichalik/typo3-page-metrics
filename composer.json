{
	"name": "konradmichalik/typo3-page-metrics",
	"description": "Page-level metrics inside the TYPO3 backend, resolved from arbitrary URLs to page UIDs, from swappable data providers.",
	"license": [
		"GPL-2.0-or-later"
	],
	"type": "typo3-cms-extension",
	"version": "0.1.0",
	"authors": [
		{
			"name": "Konrad Michalik",
			"email": "hej@konradmichalik.dev",
			"role": "Maintainer"
		}
	],
	"require": {
		"php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
		"ext-hash": "*",
		"ext-json": "*",
		"ext-zlib": "*",
		"doctrine/dbal": "^4.0",
		"firebase/php-jwt": "^7.0",
		"psr/event-dispatcher": "^1.0",
		"psr/http-message": "^1.0 || ^2.0",
		"symfony/console": "^7.0 || ^8.0",
		"symfony/dependency-injection": "^7.0 || ^8.0",
		"typo3/cms-backend": "^13.4 || ^14.0",
		"typo3/cms-core": "^13.4 || ^14.0"
	},
	"require-dev": {
		"ext-openssl": "*",
		"composer/class-map-generator": "^1.7",
		"eliashaeussler/version-bumper": "^4.0.4",
		"guzzlehttp/psr7": "^2.0",
		"konradmichalik/ttt": "^0.4.0",
		"phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
		"typo3/cms-base-distribution": "^13.4 || ^14.0",
		"typo3/cms-dashboard": "^13.4 || ^14.0",
		"typo3/cms-extbase": "^13.4 || ^14.0",
		"typo3/cms-frontend": "^13.4 || ^14.0",
		"typo3/cms-lowlevel": "^13.4 || ^14.0",
		"typo3/cms-redirects": "^13.4 || ^14.0",
		"typo3/testing-framework": "^8.2 || ^9.0.3 || ^10.0"
	},
	"suggest": {
		"typo3/cms-dashboard": "Enables the dashboard widgets. Those with settings, including 'Page metrics', need TYPO3 14."
	},
	"autoload": {
		"psr-4": {
			"KonradMichalik\\Typo3PageMetrics\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"KonradMichalik\\PageMetricsDemoProvider\\": "Tests/Functional/Service/Fixtures/Extensions/page_metrics_demo_provider/Classes/",
			"KonradMichalik\\PageMetricsDemoTiles\\": "Tests/Functional/Service/Fixtures/Extensions/page_metrics_demo_tiles/Classes/",
			"KonradMichalik\\Typo3PageMetrics\\Tests\\": "Tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"eliashaeussler/version-bumper": true,
			"ergebnis/composer-normalize": true,
			"php-http/discovery": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"platform": {
			"php": "8.2"
		},
		"sort-packages": true
	},
	"extra": {
		"konradmichalik/php-cs-fixer-preset": {
			"copyright": 2026
		},
		"typo3/cms": {
			"Package": {
				"providesPackages": {}
			},
			"cms-package-dir": "{$vendor-dir}/typo3/cms",
			"extension-key": "typo3_page_metrics",
			"web-dir": "public"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@cgl install"
		],
		"cgl": "@composer -d Tests/CGL --",
		"test": "@test:unit",
		"test:coverage": [
			"@test:coverage:unit",
			"@test:coverage:functional",
			"@test:coverage:merge"
		],
		"test:coverage:functional": "@php -d memory_limit=1024M vendor/bin/phpunit -c phpunit.functional.xml --coverage-php .Build/coverage/functional.cov",
		"test:coverage:merge": "@php Tests/Coverage/merge.php",
		"test:coverage:unit": "phpunit -c phpunit.xml --coverage-php .Build/coverage/unit.cov",
		"test:functional": "@php -d memory_limit=1024M vendor/bin/phpunit -c phpunit.functional.xml",
		"test:unit": "phpunit -c phpunit.xml --no-coverage"
	}
}
