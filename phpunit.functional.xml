<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnSkippedTests="true"
         bootstrap="vendor/typo3/testing-framework/Resources/Core/Build/FunctionalTestsBootstrap.php"
         colors="true"
>
    <php>
        <env name="typo3DatabaseDriver" value="pdo_sqlite" />
        <!-- Kept for anyone running phpunit by hand, but it is not what
             actually applies: the value here loses to the limit the process
             already started with, which is why the composer script passes
             -d memory_limit instead. The whole suite runs in one process and
             TYPO3's generated TCA schema cache is a large include on top of
             whatever the tests hold, so the ceiling is about suite size
             rather than about any one test: 512M stopped being enough at
             around 400 tests, and the peak is 534M at 449. -->
        <ini name="memory_limit" value="1024M" />
    </php>
    <testsuites>
        <testsuite name="Functional">
            <directory>Tests/Functional</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>Classes</directory>
        </include>
    </source>
</phpunit>
