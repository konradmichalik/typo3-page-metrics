parameters:
	ignoreErrors:
		-
			# typePerfect flags handleRequest()'s ServerRequestInterface parameter
			# as "too wide" because today only the concrete TYPO3\CMS\Core\Http\
			# ServerRequest ever flows through the backend AJAX route dispatcher.
			# The interface is intentional, not an oversight: every core backend
			# controller type-hints ServerRequestInterface for exactly this
			# reason, since any request-decorating PSR-15 middleware could pass a
			# different ServerRequestInterface implementation, which would throw
			# a TypeError against the concrete class. Narrowing back to the
			# concrete type would reintroduce that fragility.
			identifier: typePerfect.narrowPublicClassMethodParamType
			count: 1
			path: ../../Classes/Controller/Ajax/PageMetricsTilesController.php
		-
			# Same reasoning, same route dispatcher, for the preferences write.
			identifier: typePerfect.narrowPublicClassMethodParamType
			count: 1
			path: ../../Classes/Controller/Ajax/PageMetricsPreferencesController.php
		-
			# itemsProcFunc has a fixed, framework-mandated signature -
			# array &$parameters passed by reference - the same contract TYPO3
			# core's own TcaSystemLanguageCollector::populateAvailableSiteLanguages()
			# implements. Not a code smell, just not expressible any other way.
			identifier: ergebnis.noParameterPassedByReference
			count: 1
			path: ../../Classes/UserFunction/AnnotationSiteItemsProcFunc.php
		-
			# MetricDefinition, RateMetricDefinition, MetricTile and UrlMetric are
			# `@api` value objects whose trailing optional parameter (polarity /
			# dimension) carries the overwhelmingly common case as its default:
			# almost every metric is one where a rise is an improvement, and
			# almost every UrlMetric has no dimension. Removing the default would
			# force every call site, including third-party providers and tile
			# listeners, to spell out that common case for no correctness
			# benefit - the constructor is not ambiguous, it has a single obvious
			# optional trailing field. Accepted as an intentional, already-tested
			# API shape rather than a defect. TopPage, which is not `@api` and has
			# exactly one call site, deliberately does not get a default.
			identifier: ergebnis.noConstructorParameterWithDefaultValue
			count: 1
			path: ../../Classes/Domain/ValueObject/MetricDefinition.php
		-
			identifier: ergebnis.noConstructorParameterWithDefaultValue
			count: 1
			path: ../../Classes/Domain/ValueObject/RateMetricDefinition.php
		-
			identifier: ergebnis.noConstructorParameterWithDefaultValue
			count: 1
			path: ../../Classes/Domain/ValueObject/MetricTile.php
		-
			identifier: ergebnis.noConstructorParameterWithDefaultValue
			count: 1
			path: ../../Classes/Domain/ValueObject/UrlMetric.php
		-
			# LogLine has 10 same-shaped scalar/nullable-scalar parameters
			# (ip, method, target, protocol, status, bytesSent, referer,
			# userAgent, host, ...). Positional construction in tests would be
			# exactly the kind of adjacent-parameter transposition named
			# arguments exist to prevent - each fixture only overrides the one
			# or two fields the test cares about. Accepted as safer than the
			# rule it violates.
			identifier: ergebnis.noNamedArgument
			count: 10
			path: ../../Tests/Unit/Analysis/Aggregate/AggregatorTest.php
		-
			identifier: ergebnis.noNamedArgument
			count: 10
			path: ../../Tests/Unit/Analysis/Guard/PathHeuristicGuardTest.php
		-
			identifier: ergebnis.noNamedArgument
			count: 20
			path: ../../Tests/Unit/Analysis/Parser/LogLineTest.php
		-
			identifier: ergebnis.noNamedArgument
			count: 10
			path: ../../Tests/Unit/Analysis/Taxonomy/BotTaxonomyTest.php
