parameters:
	ignoreErrors:
		-
			# typePerfect flags handleRequest()'s ServerRequestInterface parameter
			# as "too wide" because today only the concrete TYPO3\CMS\Core\Http\
			# ServerRequest ever flows through the backend AJAX route dispatcher.
			# The interface is intentional, not an oversight: every core backend
			# controller type-hints ServerRequestInterface for exactly this
			# reason, since any request-decorating PSR-15 middleware could pass a
			# different ServerRequestInterface implementation, which would throw
			# a TypeError against the concrete class. Narrowing back to the
			# concrete type would reintroduce that fragility.
			identifier: typePerfect.narrowPublicClassMethodParamType
			count: 1
			path: ../../Classes/Controller/Ajax/PageMetricsTilesController.php
		-
			# itemsProcFunc has a fixed, framework-mandated signature -
			# array &$parameters passed by reference - the same contract TYPO3
			# core's own TcaSystemLanguageCollector::populateAvailableSiteLanguages()
			# implements. Not a code smell, just not expressible any other way.
			identifier: ergebnis.noParameterPassedByReference
			count: 1
			path: ../../Classes/UserFunction/AnnotationSiteItemsProcFunc.php
		-
			# MetricDefinition and UrlMetric are `@api` value objects whose trailing
			# nullable parameter (maxDimensions / dimension) means "not applicable"
			# for the common case. Removing the default would force every call
			# site (both production sources and their tests, several of which
			# assert the "defaults to null" behaviour by name) to pass an explicit
			# `null`, for no correctness benefit - the constructor is not
			# ambiguous, it has a single obvious optional trailing field. Accepted
			# as an intentional, already-tested API shape rather than a defect.
			identifier: ergebnis.noConstructorParameterWithDefaultValue
			count: 1
			path: ../../Classes/Domain/ValueObject/MetricDefinition.php
		-
			identifier: ergebnis.noConstructorParameterWithDefaultValue
			count: 1
			path: ../../Classes/Domain/ValueObject/UrlMetric.php
