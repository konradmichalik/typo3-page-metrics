includes:
	- %rootDir%/../../konradmichalik/phpstan-typo3-preset/phpstan.neon.dist
	- phpstan-baseline.neon

parameters:
	level: 8
	phpVersion: 80200

	scanDirectories:
		- ../../vendor
	paths:
		- ../../Classes
		- ../../Configuration
		- ../../Tests/Unit
		- ../../Tests/Functional

	typo3:
		requestGetAttributeMapping:
			id: 'string'
