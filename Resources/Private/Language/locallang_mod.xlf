            </trans-unit>
            <trans-unit id="module.link" resname="module.link">
                <source>Open full view</source>
            </trans-unit>
            <trans-unit id="module.link.hint" resname="module.link.hint">
                <source>Every metric as a labelled table, the chart over the whole period, and the period's markers as a list.</source>
            </trans-unit>
            <trans-unit id="module.compare.baseline.label" resname="module.compare.baseline.label">
                <source>Compare against</source>
            </trans-unit>
            <trans-unit id="module.compare.baseline.previous" resname="module.compare.baseline.previous">
                <source>The period immediately before</source>
            </trans-unit>
            <trans-unit id="module.compare.baseline.month" resname="module.compare.baseline.month">
                <source>The same days one month earlier</source>
            </trans-unit>
            <trans-unit id="module.compare.baseline.quarter" resname="module.compare.baseline.quarter">
